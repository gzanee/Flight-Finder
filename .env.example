# Flight Finder non richiede credenziali: i dati arrivano da Google Flights
# tramite librerie non ufficiali. Tutte le variabili qui sotto sono opzionali.

# Paese e lingua usati nelle richieste a Google. Determinano i prezzi mostrati
# e le compagnie proposte: lasciare IT se si parte dall'Italia.
GOOGLE_COUNTRY=IT
GOOGLE_LANGUAGE=it

# Valuta dei prezzi (codice ISO 4217).
CURRENCY=EUR

# Porta del server locale.
PORT=5001

# Impostare a 0 per disattivare il reload automatico di Flask.
FLASK_DEBUG=1

# DEBUG mostra ogni richiesta a Google: utile per capire perche' una
# ricerca torna vuota.
LOG_LEVEL=INFO

# Dove tenere il cookie di consenso di Google.
# FLIGHT_FINDER_CACHE_DIR=.cache
